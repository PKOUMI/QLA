# =============================================================================
# Backend environment variables  (Vercel -> Project -> Settings -> Environment Variables)
#
# NEVER commit a real .env file. NEVER put any of these in config.js or any
# other file the browser downloads. This file is a template only.
# =============================================================================

# --- Email provider ----------------------------------------------------------
# Get this from https://resend.com -> API Keys. Treat it like a password.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The address emails are sent from. Must be on a domain you have verified in
# Resend. Before you own a domain you can use onboarding@resend.dev, which only
# delivers to the email address on your own Resend account — useful for testing.
FROM_EMAIL=feedback@yourdomain.co.uk
FROM_NAME=Assessment Feedback

# --- Security ----------------------------------------------------------------
# Comma-separated list of sites allowed to call this API. No trailing slashes.
# Include your GitHub Pages URL and, later, your custom domain.
ALLOWED_ORIGINS=https://yourusername.github.io,https://app.yourdomain.co.uk

# A long random string. Paste the same value into the app under Settings.
# Generate one with:  openssl rand -base64 32
APP_SHARED_KEY=change-me-to-a-long-random-string

# --- Limits ------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=6
MAX_EMAILS_PER_HOUR=500

# --- Testing -----------------------------------------------------------------
# Set to true to exercise the whole flow WITHOUT sending real email.
# Results are clearly labelled as simulated in the app. Leave unset in production.
# DRY_RUN=true
